# Copy to .env and edit. Never commit .env.
WAGGLE_SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
WAGGLE_DEBUG=1
WAGGLE_ALLOWED_HOSTS=localhost,127.0.0.1
WAGGLE_DATA_DIR=./data
WAGGLE_HTTP_PORT=8000

# Orchestrator backend (default: real Docker Swarm)
WAGGLE_ORCHESTRATOR=orchestrator.swarm:SwarmOrchestrator
# WAGGLE_DOCKER_URL=unix:///var/run/docker.sock
