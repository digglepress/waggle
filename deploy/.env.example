# Generated by deploy/install.sh. Keep this file out of git.
WAGGLE_SECRET_KEY=replace-me
WAGGLE_DEBUG=0
# M1 has no TLS yet: tighten this to your hostname/IP and put a proxy in front.
WAGGLE_ALLOWED_HOSTS=*
WAGGLE_HTTP_PORT=8000
# Set to 1 once TLS terminates in front of Waggle.
WAGGLE_SECURE_COOKIES=0
