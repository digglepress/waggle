# Generated by deploy/install.sh. Keep this file out of git.
WAGGLE_SECRET_KEY=replace-me
# Ordered key ring for rotation. Prepend a new key, keep the old one.
# WAGGLE_SECRET_KEYS=new-key,old-key
WAGGLE_DEBUG=0
# Tighten this to your hostname/IP before exposing the control plane.
WAGGLE_ALLOWED_HOSTS=*
WAGGLE_HTTP_PORT=8000
# Set to 1 once TLS terminates in front of Waggle.
WAGGLE_SECURE_COOKIES=0
# Production defaults to redirecting HTTP to HTTPS; the local installer sets 0.
WAGGLE_SSL_REDIRECT=0
# Pinned release image, written by install.sh/upgrade.sh.
# WAGGLE_IMAGE=ghcr.io/owner/waggle@sha256:…
# Control-plane memory limits (the 1 GB profile defaults to 384m + 256m).
# WAGGLE_WEB_MEMORY=384m
# WAGGLE_WORKER_MEMORY=256m
# Require a cosign signature from the release workflow.
# WAGGLE_REQUIRE_SIGNATURE=1
# WAGGLE_COSIGN_IDENTITY=https://github.com/OWNER/REPO/.github/workflows/release.yml@refs/tags/v1.2.3
# Optional application routing and build registry. See README.md.
# WAGGLE_ROUTE_TLS=1
# WAGGLE_TRAEFIK_CERT_RESOLVER=letsencrypt
# Browser terminal grants command execution to trusted operators only.
# WAGGLE_WEB_TERMINAL=1
# WAGGLE_REGISTRY_HOST=registry.example.org:5000
# WAGGLE_REGISTRY_BIND=10.0.0.10:5000
# WAGGLE_REGISTRY_FILES=/etc/waggle/registry
# WAGGLE_DOCKER_CONFIG_DIR=/etc/waggle/docker-auth
# Optional Prometheus endpoint (use a randomly generated token).
# WAGGLE_METRICS_TOKEN=
# Optional Slack-compatible webhook for deployment results.
# WAGGLE_NOTIFY_WEBHOOK_URL=https://hooks.slack.com/services/…
# Structured JSON logs for Loki/CloudWatch/ELK.
# WAGGLE_LOG_JSON=1
# Deployment convergence and automatic rollback.
# WAGGLE_DEPLOY_CONVERGE_TIMEOUT=180
# A first pull of a large image can exceed the convergence timeout. While tasks
# are preparing, Waggle keeps waiting up to this many seconds.
# WAGGLE_DEPLOY_PULL_TIMEOUT=1800
# WAGGLE_DEPLOY_PROGRESS_INTERVAL=10
# WAGGLE_DEPLOY_AUTO_ROLLBACK=1
